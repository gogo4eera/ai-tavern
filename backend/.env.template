# AI Tavern NPC Backend Configuration Template
# Copy this file to a new file named '.env' in this directory and fill in your keys.

# LLM Model Config
# Available models via LiteLLM, e.g.:
# - anthropic/claude-sonnet-4-6
# - gemini/gemini-3.5-flash
# - openai/gpt-5
LLM_MODEL=anthropic/claude-sonnet-4-6

# Optional: Custom API base URL (e.g. for Ollama, LocalAI, vLLM, or custom proxies)
# LLM_API_BASE=http://localhost:11434

# API Keys (Provide the key for the provider you want to use)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
